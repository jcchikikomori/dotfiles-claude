#!/bin/bash
SETTINGS_FILE="$HOME/.claude/settings.json"
mkdir -p "$HOME/.claude"

# Create file with valid JSON if it doesn't exist
[ -f "$SETTINGS_FILE" ] || echo "{}" > "$SETTINGS_FILE"

# Full 22 verbs list
NEW_VERBS='[
  "Synergizing the deliverables",
  "Circling back aggressively",
  "Putting a pin in it",
  "Circling back to circle back",
  "Boiling the ocean",
  "Let’s take this offline",
  "The new normal of this workflow",
  "Hard-stopping at the next hard stop",
  "Parking lot this for later",
  "Quiet-quitting the standup",
  "Bikeshedding the color scheme",
  "Reply-all-ing the entire org",
  "Running it up the flagpole",
  "Eating our own dog food",
  "Opening the kimono",
  "Right-sizing the headcount",
  "Ideating at a 30,000-foot level",
  "Grabbing the low-hanging fruit",
  "Pinging you per my last email",
  "Unpacking this going forward",
  "Being a thought leader about this",
  "Double-clicking on that"
]'

# Write spinnerVerbs as an object: { "mode": "replace", "verbs": [...] }
tmp=$(mktemp)
jq --argjson verbs "$NEW_VERBS" \
  '.spinnerVerbs = { "mode": "replace", "verbs": $verbs }' \
  "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"

echo "Updated $SETTINGS_FILE successfully!"
